<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>

<VBox styleClass="game" xmlns:fx="http://javafx.com/fxml" fx:controller="com.frogger.controller.GameController" stylesheets="@/view/game/GameStyles.css">
    <Button text="Retour" fx:id="btnBack"/>
    <StackPane styleClass="gameStackPane">
        <GridPane fx:id="grid" styleClass="grid"/>
        <GridPane fx:id="obstacleLayer" styleClass="obstacle-pane"/>
    </StackPane>
</VBox>
