<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<VBox xmlns:fx="http://javafx.com/fxml" stylesheets="@/view/menu/MenuStyles.css"
      fx:controller="com.frogger.controller.MenuController"
      styleClass="menu">
    <Text text="Froggy Road" styleClass="game-title"/>
    <VBox styleClass="menu-buttons" alignment="CENTER" spacing="15">
        <Button text="Jouer Solo" fx:id="btnSolo" styleClass="button"/>
        <Button text="Jouer Duo" fx:id="btnDuo" styleClass="button"/>
        <Button text="Paramètres" fx:id="btnSettings" styleClass="button"/>
        <Button text="Quitter" fx:id="btnQuit" styleClass="button"/>
    </VBox>
</VBox>